# Multi-Tenant Platform Configuration

# Base domain untuk routing (Traefik akan handle *.yourdomain.com)
BASE_DOMAIN=damantine.web.id

# Docker Hub Credentials (Optional)
# Jika tidak diisi, pull akan tetap jalan tapi kena rate limit Docker Hub
# Isi ini dengan akun Docker Hub kamu untuk authenticated pulls (200 pulls/6 jam)
DOCKER_HUB_USERNAME=
DOCKER_HUB_PASSWORD=
